{
  "id": "book_quiz",
  "title": "Quiz",
  "canvas": {
    "desktop": { "width": 1280, "height": 800 },
    "tablet": { "width": 768, "height": 1024 },
    "mobile": { "width": 390, "height": 844 }
  },
  "pages": [
    {
      "id": "page_quiz",
      "name": "Quiz",
      "script": "function pageEnter() {\n  store.set('score', 0)\n}\n",
      "background": "#ffffff",
      "objects": [
        {
          "id": "obj_quiz_question",
          "name": "questionLabel",
          "control": "label",
          "rects": { "desktop": { "x": 96, "y": 96, "w": 640, "h": 56 } },
          "props": { "text": "Which city is the capital of France?" },
          "on": {}
        },
        {
          "id": "obj_quiz_paris",
          "name": "parisButton",
          "control": "button",
          "rects": { "desktop": { "x": 96, "y": 200, "w": 240, "h": 48 } },
          "props": { "text": "Paris" },
          "on": {
            "click": "store.set('score', 1)\npage.go('Results')"
          }
        },
        {
          "id": "obj_quiz_london",
          "name": "londonButton",
          "control": "button",
          "rects": { "desktop": { "x": 360, "y": 200, "w": 240, "h": 48 } },
          "props": { "text": "London" },
          "on": {
            "click": "store.set('score', 0)\npage.go('Results')"
          }
        },
        {
          "id": "obj_quiz_berlin",
          "name": "berlinButton",
          "control": "button",
          "rects": { "desktop": { "x": 624, "y": 200, "w": 240, "h": 48 } },
          "props": { "text": "Berlin" },
          "on": {
            "click": "store.set('score', 0)\npage.go('Results')"
          }
        }
      ]
    },
    {
      "id": "page_results",
      "name": "Results",
      "script": "function pageEnter() {\n  store.set('verdict', store.get('score') ? 'Nice!' : 'Try again')\n}\n",
      "background": "#ffffff",
      "objects": [
        {
          "id": "obj_results_score",
          "name": "scoreLabel",
          "control": "label",
          "rects": { "desktop": { "x": 96, "y": 96, "w": 640, "h": 56 } },
          "props": { "text": "Score: {{score}} - {{verdict}}" },
          "on": {}
        },
        {
          "id": "obj_results_again",
          "name": "againButton",
          "control": "button",
          "rects": { "desktop": { "x": 96, "y": 200, "w": 240, "h": 48 } },
          "props": { "text": "Play again" },
          "on": {
            "click": "page.go('Quiz')"
          }
        }
      ]
    }
  ]
}
