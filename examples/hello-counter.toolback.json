{
  "formatVersion": 1,
  "id": "book_hello_counter",
  "title": "Hello Counter",
  "backgrounds": [
    {
      "id": "bg_44b5c3372",
      "name": "Background 1",
      "color": "#ffffff",
      "script": "",
      "objects": []
    }
  ],
  "pages": [
    {
      "id": "page_counter",
      "name": "Counter",
      "script": "function pageEnter() {\n  store.set('count', 100)\n}\n",
      "backgroundId": "bg_44b5c3372",
      "objects": [
        {
          "id": "obj_counter_label",
          "name": "counterLabel",
          "control": "label",
          "x": {
            "mode": "left",
            "left": 96,
            "width": 480
          },
          "y": {
            "mode": "top",
            "top": 96,
            "height": 56
          },
          "props": {
            "text": "Count: {{count}}"
          },
          "on": {}
        },
        {
          "id": "obj_counter_add",
          "name": "addButton",
          "control": "button",
          "x": {
            "mode": "left",
            "left": 96,
            "width": 176
          },
          "y": {
            "mode": "top",
            "top": 184,
            "height": 48
          },
          "props": {
            "text": "+1"
          },
          "on": {
            "click": "store.set('count', (store.get('count') ?? 0) + 1)"
          }
        },
        {
          "id": "obj_counter_reset",
          "name": "resetButton",
          "control": "button",
          "x": {
            "mode": "left",
            "left": 296,
            "width": 176
          },
          "y": {
            "mode": "top",
            "top": 184,
            "height": 48
          },
          "props": {
            "text": "Reset"
          },
          "on": {
            "click": "store.set('count', 0)"
          }
        },
        {
          "id": "obj_counter_hint",
          "name": "hintLabel",
          "control": "label",
          "x": {
            "mode": "left",
            "left": 96,
            "width": 480
          },
          "y": {
            "mode": "top",
            "top": 280,
            "height": 56
          },
          "props": {
            "text": "Press Run — pageEnter seeds count = 100, the +1 button's click script bumps it, the label is bound with {{count}}."
          },
          "on": {}
        }
      ]
    }
  ],
  "store": []
}