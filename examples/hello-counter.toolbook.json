{
  "id": "book_hello_counter",
  "title": "Hello Counter",
  "canvas": {
    "desktop": { "width": 1280, "height": 800 },
    "tablet": { "width": 768, "height": 1024 },
    "mobile": { "width": 390, "height": 844 }
  },
  "pages": [
    {
      "id": "page_counter",
      "name": "Counter",
      "script": "function pageEnter() {\n  store.set('count', 100)\n}\n",
      "background": "#ffffff",
      "objects": [
        {
          "id": "obj_counter_label",
          "name": "counterLabel",
          "control": "label",
          "rects": { "desktop": { "x": 96, "y": 96, "w": 480, "h": 56 } },
          "props": { "text": "Count: {{count}}" },
          "on": {}
        },
        {
          "id": "obj_counter_add",
          "name": "addButton",
          "control": "button",
          "rects": { "desktop": { "x": 96, "y": 184, "w": 176, "h": 48 } },
          "props": { "text": "+1" },
          "on": {
            "click": "store.set('count', (store.get('count') ?? 0) + 1)"
          }
        },
        {
          "id": "obj_counter_reset",
          "name": "resetButton",
          "control": "button",
          "rects": { "desktop": { "x": 296, "y": 184, "w": 176, "h": 48 } },
          "props": { "text": "Reset" },
          "on": {
            "click": "store.set('count', 0)"
          }
        },
        {
          "id": "obj_counter_hint",
          "name": "hintLabel",
          "control": "label",
          "rects": { "desktop": { "x": 96, "y": 280, "w": 480, "h": 40 } },
          "props": { "text": "Press Run — pageEnter seeds count = 100, the +1 button's click script bumps it, the label is bound with {{count}}." },
          "on": {}
        }
      ]
    }
  ]
}
