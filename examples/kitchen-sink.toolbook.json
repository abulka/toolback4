    {
      "id": "page_ks_store",
      "name": "Store",
      "script": "function pageEnter() {\n  store.set('where', page.name)\n  if (store.get('clicks') === undefined) store.set('clicks', 0)\n  if (store.get('who') === undefined) store.set('who', 'stranger')\n  if (store.get('dark') === undefined) store.set('dark', true)\n}\n",
