          "name": "stTip1",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 512, "w": 1150, "h": 72 } },
          "props": { "text": "Where the scripts live: nameInput's Script panel has two handlers (input + change) reading event.target.value. clickButton has click + dblclick — a double-click fires click twice, then dblclick resets the count. Lock click writes clickButton.enabled.", "fontSize": 14 },
          "on": {}
