    {
      "id": "page_ks_groups",
      "name": "Groups",
      "script": "function pageEnter() {\n  store.set('where', page.name)\n  if (store.get('memberRan') === undefined) store.set('memberRan', '—')\n  if (store.get('groupRan') === undefined) store.set('groupRan', '—')\n}\n",
      "background": "#f6f7fb",
      "objects": [
        {
          "id": "obj_ks_gpTitle",
          "name": "gpTitle",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 32, "w": 1050, "h": 48 } },
          "props": { "text": "Groups & forward — the ToolBook event rule", "fontSize": 22 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpHint1",
          "name": "gpHint1",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 96, "w": 1180, "h": 64 } },
          "props": { "text": "Rule: the innermost script for an event runs and STOPS there unless it calls forward(). An object with no script for that event lets the event pass to its parent group automatically. In a group's script, target is the member that was clicked and self is the group itself.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpHint2",
          "name": "gpHint2",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 176, "w": 1180, "h": 48 } },
          "props": { "text": "groupA below holds two buttons AND another group (groupInner) holding a third — nested groups. Press Run and click each button:", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mnBack3",
          "name": "mnBack3",
          "control": "button",
          "rects": { "desktop": { "x": 1080, "y": 32, "w": 152, "h": 48 } },
          "props": { "text": "← Menu" },
          "on": {
            "click": "page.go('Home')"
          }
        }
,
        {
          "id": "obj_ks_groupA",
          "name": "groupA",
          "control": "group",
          "rects": { "desktop": { "x": 96, "y": 240, "w": 520, "h": 224 } },
          "props": {},
          "on": {
            "click": "store.set('groupRan', self.name + ' saw ' + target.name)"
          },
          "children": [
            {
              "id": "obj_ks_btnFwd",
