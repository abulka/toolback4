          "on": {}
        }

      ]
    },
    {
      "id": "page_ks_motion",
      "name": "Motion",
      "script": "async function pageEnter() {\n  store.set('where', page.name)\n  mover.x = 420\n  mover.y = -160\n  for (let i = 0; i < 18; i++) {\n    await new Promise((r) => setTimeout(r, 16))\n    mover.y += 20\n  }\n  mover.y = 200\n}\n\nfunction pageLeave() {\n  store.set('leftMotion', true)\n}\n\nfunction resetBox() {\n  box.x = 640\n  box.y = 360\n  box.width = 240\n  box.height = 140\n  box.visible = true\n}\n",
      "background": "#f1f5f9",
      "objects": [
        {
          "id": "obj_ks_mtTitle",
          "name": "mtTitle",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 32, "w": 1050, "h": 48 } },
          "props": { "text": "Scripted motion — x / y / width / height, await, pageEnter", "fontSize": 22 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mtHint",
          "name": "mtHint",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 96, "w": 1180, "h": 48 } },
          "props": { "text": "Positions and sizes are writable from scripts. pageEnter already ran the drop-in animation on the mover card the moment this page opened.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mover",
          "name": "mover",
          "control": "card",
          "rects": { "desktop": { "x": 420, "y": 200, "w": 240, "h": 140 } },
          "props": { "title": "I move", "text": "pageEnter drops me in from the top" },
          "on": {}
        }
,
        {
          "id": "obj_ks_randomButton",
          "name": "randomButton",
          "control": "button",
          "rects": { "desktop": { "x": 96, "y": 200, "w": 240, "h": 48 } },
          "props": { "text": "Random spot" },
          "on": {
            "click": "mover.x = 100 + Math.floor(Math.random() * 800)\nmover.y = 150 + Math.floor(Math.random() * 420)"
          }
        }
,
        {
          "id": "obj_ks_sizeButton",
