    {
      "id": "page_ks_groups",
      "name": "Groups",
      "script": "function pageEnter() {\n  store.set('where', page.name)\n  if (store.get('memberRan') === undefined) store.set('memberRan', '—')\n  if (store.get('groupRan') === undefined) store.set('groupRan', '—')\n}\n",
      "background": "#f6f7fb",
      "objects": [
        {
          "id": "obj_ks_gpTitle",
          "name": "gpTitle",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 32, "w": 1050, "h": 48 } },
          "props": { "text": "Groups & forward — the ToolBook event rule", "fontSize": 22 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpHint1",
          "name": "gpHint1",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 96, "w": 1180, "h": 64 } },
          "props": { "text": "Rule: the innermost script for an event runs and STOPS there unless it calls forward(). An object with no script for that event lets the event pass to its parent group automatically. In a group's script, target is the member that was clicked and self is the group itself.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpHint2",
          "name": "gpHint2",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 176, "w": 1180, "h": 48 } },
          "props": { "text": "groupA below holds two buttons AND another group (groupInner) holding a third — nested groups. Press Run and click each button:", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mnBack3",
          "name": "mnBack3",
          "control": "button",
          "rects": { "desktop": { "x": 1080, "y": 32, "w": 152, "h": 48 } },
          "props": { "text": "← Menu" },
          "on": {
            "click": "page.go('Home')"
          }
        }
,
        {
          "id": "obj_ks_groupA",
          "name": "groupA",
          "control": "group",
          "rects": { "desktop": { "x": 96, "y": 240, "w": 520, "h": 224 } },
          "props": {},
          "on": {
            "click": "store.set('groupRan', self.name + ' saw ' + target.name)"
          },
          "children": [
            {
              "id": "obj_ks_btnFwd",
              "name": "btnFwd",
              "control": "button",
              "rects": { "desktop": { "x": 16, "y": 16, "w": 232, "h": 56 } },
              "props": { "text": "I have a script + forward()" },
              "on": {
                "click": "store.set('memberRan', self.name)\nforward()"
              }
            }
,
            {
              "id": "obj_ks_btnQuiet",
              "name": "btnQuiet",
              "control": "button",
              "rects": { "desktop": { "x": 264, "y": 16, "w": 232, "h": 56 } },
              "props": { "text": "I have no script" },
              "on": {}
            }
,
            {
              "id": "obj_ks_groupInner",
              "name": "groupInner",
              "control": "group",
              "rects": { "desktop": { "x": 16, "y": 88, "w": 488, "h": 72 } },
              "props": {},
              "on": {},
              "children": [
                {
                  "id": "obj_ks_btnDeep",
                  "name": "btnDeep",
                  "control": "button",
                  "rects": { "desktop": { "x": 16, "y": 8, "w": 456, "h": 56 } },
                  "props": { "text": "Deep in a nested group" },
                  "on": {}
                }

              ]
            }

          ]
        }
,
        {
          "id": "obj_ks_gpMember",
          "name": "gpMember",
          "control": "label",
          "rects": { "desktop": { "x": 648, "y": 240, "w": 560, "h": 36 } },
          "props": { "text": "Member script ran on: {{memberRan}}", "fontSize": 16 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpGroup",
          "name": "gpGroup",
          "control": "label",
          "rects": { "desktop": { "x": 648, "y": 284, "w": 560, "h": 36 } },
          "props": { "text": "Group handler: {{groupRan}}", "fontSize": 16 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip1",
          "name": "gpTip1",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 496, "w": 1180, "h": 76 } },
          "props": { "text": "Try it: click \"I have a script + forward()\" — its own script runs, then forward() continues up to groupA (groupRan reads self = groupA, target = btnFwd). Click \"I have no script\" or the nested button — no member script exists, so the event walks btnDeep → groupInner → groupA and the group handler catches it with target = the button you clicked.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip2",
          "name": "gpTip2",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 584, "w": 1180, "h": 76 } },
          "props": { "text": "Where the scripts live: exactly two. groupA's click handler (click the group once to select it — double-click drills in, Esc steps out) is store.set('groupRan', self.name + ' saw ' + target.name). btnFwd's click is store.set('memberRan', self.name) followed by forward(). groupInner and the other buttons have NO scripts — which is precisely why the message passes through them.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip3",
          "name": "gpTip3",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 672, "w": 1180, "h": 40 } },
          "props": { "text": "Design tip: ⌥G groups a selection, ⌥U ungroups, double-click drills one level per double-click, Esc steps out one level and is ignored at the outermost level.", "fontSize": 14 },
          "on": {}
        }

      ]
    },
    {
      "id": "page_ks_motion",
      "name": "Motion",
      "script": "async function pageEnter() {\n  store.set('where', page.name)\n  mover.x = 420\n  mover.y = -160\n  for (let i = 0; i < 18; i++) {\n    await new Promise((r) => setTimeout(r, 16))\n    mover.y += 20\n  }\n  mover.y = 200\n}\n\nfunction pageLeave() {\n  store.set('leftMotion', true)\n}\n\nfunction resetBox() {\n  box.x = 640\n  box.y = 360\n  box.width = 240\n  box.height = 140\n  box.visible = true\n}\n",
      "background": "#f1f5f9",
      "objects": [
        {
          "id": "obj_ks_mtTitle",
          "name": "mtTitle",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 32, "w": 1050, "h": 48 } },
          "props": { "text": "Scripted motion — x / y / width / height, await, pageEnter", "fontSize": 22 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mtHint",
          "name": "mtHint",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 96, "w": 1180, "h": 48 } },
          "props": { "text": "Positions and sizes are writable from scripts. pageEnter already ran the drop-in animation on the mover card the moment this page opened.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_mover",
          "name": "mover",
