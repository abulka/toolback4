          "control": "button",
          "rects": {"desktop":{"x":412,"y":216,"w":240,"h":52}},
          "props": {"text":"Play","color":"teal"},
          "on": {
            "click": "playDemo()"
          }
        }
,
        {
          "id": "obj_ks_npDownload",
          "name": "npDownload",
          "control": "button",
          "rects": {"desktop":{"x":668,"y":216,"w":240,"h":52}},
          "props": {"text":"Download .mid","color":"navy"},
          "on": {
            "click": "downloadDemo()"
          }
        }
,
        {
          "id": "obj_ks_npResult",
          "name": "npResult",
          "control": "label",
          "rects": {"desktop":{"x":96,"y":288,"w":1180,"h":40}},
          "props": {"text":"Result: {{midiInfo}}","fontSize":16},
          "on": {}
        }
,
        {
          "id": "obj_ks_npSound",
          "name": "npSound",
          "control": "label",
          "rects": {"desktop":{"x":96,"y":336,"w":1180,"h":36}},
          "props": {"text":"Sound: {{playInfo}}","fontSize":16},
