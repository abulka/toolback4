              "id": "obj_ks_groupInner",
              "name": "groupInner",
              "control": "group",
              "rects": { "desktop": { "x": 16, "y": 88, "w": 488, "h": 72 } },
              "props": {},
              "on": {},
              "children": [
                {
                  "id": "obj_ks_btnDeep",
                  "name": "btnDeep",
                  "control": "button",
                  "rects": { "desktop": { "x": 16, "y": 8, "w": 456, "h": 56 } },
                  "props": { "text": "Deep in a nested group" },
                  "on": {}
                }

              ]
            }

          ]
        }
,
        {
          "id": "obj_ks_gpMember",
          "name": "gpMember",
          "control": "label",
          "rects": { "desktop": { "x": 648, "y": 240, "w": 560, "h": 36 } },
          "props": { "text": "Member script ran on: {{memberRan}}", "fontSize": 16 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpGroup",
          "name": "gpGroup",
          "control": "label",
          "rects": { "desktop": { "x": 648, "y": 284, "w": 560, "h": 36 } },
          "props": { "text": "Group handler: {{groupRan}}", "fontSize": 16 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip1",
          "name": "gpTip1",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 496, "w": 1180, "h": 76 } },
          "props": { "text": "Try it: click \"I have a script + forward()\" — its own script runs, then forward() continues up to groupA (groupRan reads self = groupA, target = btnFwd). Click \"I have no script\" or the nested button — no member script exists, so the event walks btnDeep → groupInner → groupA and the group handler catches it with target = the button you clicked.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip2",
          "name": "gpTip2",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 584, "w": 1180, "h": 76 } },
          "props": { "text": "Where the scripts live: exactly two. groupA's click handler (click the group once to select it — double-click drills in, Esc steps out) is store.set('groupRan', self.name + ' saw ' + target.name). btnFwd's click is store.set('memberRan', self.name) followed by forward(). groupInner and the other buttons have NO scripts — which is precisely why the message passes through them.", "fontSize": 14 },
          "on": {}
        }
,
        {
          "id": "obj_ks_gpTip3",
          "name": "gpTip3",
          "control": "label",
          "rects": { "desktop": { "x": 48, "y": 672, "w": 1180, "h": 40 } },
