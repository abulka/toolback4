      "id": "page_4d378c595",
      "name": "Page 2",
      "script": "function pageEnter() {\n  console.log('hi from page enter')\n  button2.text = 'back to the first page'\n}\n\nfunction pageEnter() {\n  console.log('page enter2 called')\n  store.set('where', page.name)\n  if (store.get('midiInfo') === undefined) store.set('midiInfo', 'nothing parsed yet — press the button')\n}\n\n// package docs say: import { Midi } from '@tonejs/midi' — in toolback the same\n// line goes inside a function, awaited. Imports resolve via esm.sh (or the shelf).\nasync function parseDemo() {\n  const { Midi } = await import('@tonejs/midi')\n  const midi = new Midi()\n  const track = midi.addTrack()\n  track.name = 'toolback demo'\n  track.addNote({ midi: 60, time: 0, duration: 0.5, velocity: 0.8 })\n  track.addNote({ midi: 64, time: 0.5, duration: 0.5, velocity: 0.8 })\n  const reparsed = new Midi(midi.toArray())\n  store.set('midiInfo', `tracks: ${reparsed.tracks.length}, notes: ${reparsed.tracks[0].notes.length}, second note: ${reparsed.tracks[0].notes[1].name}`)\n}\n\nasync function playDemo() {\n  const { Midi } = await import('@tonejs/midi');\n  const Tone = await import('tone');\n\n  const midi = new Midi();\n  const track = midi.addTrack();\n  track.name = 'toolback demo';\n  track.addNote({ midi: 60, time: 0, duration: 0.5, velocity: 0.8 });\n  track.addNote({ midi: 64, time: 0.5, duration: 0.5, velocity: 0.8 });\n\n  // --- PLAYBACK LOGIC ---\n  \n  // 1. Start the audio context (required by browsers before playing sound)\n  await Tone.start();\n\n  // 2. Create a basic synthesizer and connect it to the master output\n  const synth = new Tone.PolySynth(Tone.Synth).toDestination();\n\n  // 3. Schedule each note to play at its specified time\n  track.notes.forEach(note => {\n    synth.triggerAttackRelease(\n      note.name, \n      note.duration, \n      note.time + Tone.now(), // Offset relative to the current timeline\n      note.velocity\n    );\n  });\n}\n\nasync function parseAndDownloadDemo() {\n  const { Midi } = await import('@tonejs/midi')\n  const midi = new Midi()\n  const track = midi.addTrack()\n  track.name = 'toolback demo'\n  track.addNote({ midi: 60, time: 0, duration: 0.5, velocity: 0.8 })\n  track.addNote({ midi: 64, time: 0.5, duration: 0.5, velocity: 0.8 })\n  \n  // --- DOWNLOAD LOGIC ---\n  const midiArray = midi.toArray();\n  \n  // Create a blob from the binary array\n  const blob = new Blob([midiArray], { type: 'audio/midi' });\n  \n  // Generate a URL for the blob\n  const url = URL.createObjectURL(blob);\n  \n  // Create a temporary hidden anchor element to trigger the download\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = 'toolback_demo.mid';\n  document.body.appendChild(a);\n  a.click();\n  \n  // Clean up\n  document.body.removeChild(a);\n  URL.revokeObjectURL(url);\n}\n",
